{
    "name": "dropfan/onesignal-server-api",
    "description": "OneSignal server API for PHP, you can push notifications to any platform. \n(iOS/APNS, Android/GCM/FCM, WP, Web/Chrome/Safari...etc.) \nNo third-party dependency that you can use this library in any project or framework.",
    "keywords": [
        "onesignal",
        "onesignal api",
        "onesignal server",
        "api",
        "push",
        "push notification",
        "notification",
        "WebPush"
    ],
    "homepage": "https://github.com/DropFan/onesignal-server-api",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DropFan",
            "email": "DropFan@Gmail.com"
        }
    ],
    "require": {
        "php": ">=5.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7|^6.5|^7.5|^8.5|^9.5"
    },
    "suggest": {
        "ext-curl": "Required for making HTTP requests",
        "ext-json": "Required for JSON encoding/decoding"
    },
    "autoload": {
        "psr-4": { "OneSignalApi\\": "src/" }
    }
}
